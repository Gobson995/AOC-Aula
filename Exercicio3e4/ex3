.data
msg1:   .asciiz "Digite um valor: \n"
msg2:   .asciiz "o valor maior eh: "
msg3:   .asciiz "\n o menor valor eh: "

.text 
.globl main 

main: 
    ori     $s0, $zero, 100 
    ori     $s1, $zero, 200 
    ori     $s3, $zero, 300
   
    # le a1
    la      $a0, msg1
    li      $v0, 4 
    syscall
    li      $v0, 5 
    syscall
    or      $a1, $zero, $v0
    
    # le a2
    la      $a0, msg1
    li      $v0, 4 
    syscall 
    li      $v0, 5 
    syscall
    or      $a2, $zero, $v0 
    
    # le a3
    la      $a0, msg1
    li      $v0, 4 
    syscall 
    li      $v0, 5 
    syscall
    or      $a3, $zero, $v0 
    
    # chama a funcao
    jal     maior_menor

    # salva
    move    $s0, $v0
    move    $s1, $v1

    # imprime o maior
    la      $a0, msg2
    li      $v0, 4
    syscall
    move    $a0, $s0
    li      $v0, 1
    syscall

    # imprime o menor
    la      $a0, msg3
    li      $v0, 4
    syscall
    move    $a0, $s1
    li      $v0, 1             
    syscall

end: 
    li      $v0, 10 
    syscall 

maior_menor:
    move    $v0, $a1            # v0 = maior assumido
    move    $v1, $a1       	# v0 = menor assumido
    
    slt     $t0, $v0, $a2       # se maior < a2 -> t0 = 1
    beq     $t0, $zero, verifica_a2_menor # se t0 = 0 -> pula
    move    $v0, $a2            # se veio aqui, a2 = maior

verifica_a2_menor:
    slt     $t0, $a2, $v1       # se a2 < menor -> t0 = 1
    beq     $t0, $zero, verifica_a3_maior # se t0 = 0 -> pula
    move    $v1, $a2            # se veio aqui, a2 = menor

verifica_a3_maior:
    slt     $t0, $v0, $a3       # comparando maior com a3
    beq     $t0, $zero, verifica_a3_menor
    move    $v0, $a3      

verifica_a3_menor:
    slt     $t0, $a3, $v1       # comparando a3 com menor
    beq     $t0, $zero, fim_funcao 
    move    $v1, $a3

fim_funcao:
    jr      $ra                 # retorna pro main
