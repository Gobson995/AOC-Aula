.data
msg_entrada: .asciiz "Digite um valor inteiro N: "
msg_saida:   .asciiz "A quantidade de digitos eh: "

.text 
.globl main 

main: 
    # le o numero n
    la      $a0, msg_entrada
    li      $v0, 4 
    syscall
    li      $v0, 5          
    syscall
    
    move    $a0, $v0        
       
    # chama a função para contar os digitos
    jal     conta_digitos   
    move    $s0, $v0        

    # printa resultado
    la      $a0, msg_saida
    li      $v0, 4
    syscall
    move    $a0, $s0        
    li      $v0, 1
    syscall
    
end:
    li      $v0, 10         
    syscall 

conta_digitos:
    li      $v0, 0          # inicia o contador de dígitos em 0
    li      $t1, 10         # inicia 10 no t1 para ser o divisor
    
    abs     $t0, $a0        # modulo

while_divide:
 
    div     $t0, $t0, $t1   # divide por n por 10
    addi    $v0, $v0, 1     # soma 1 na resposta
    
    bne     $t0, $zero, while_divide # se o resultado não for zero, repete o loop.

    jr      $ra             # volta para onde chamou a função