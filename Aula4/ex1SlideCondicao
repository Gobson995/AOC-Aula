.data
vector:
.word 6
.word 8
.word 6

newline: .asciiz "\n"

.text 
la $s6, vector
li $s3, 0
li $s5, 8
.globl main

main: 
while:
sll $t0, $s3, 2
add $t0, $t0, $s6
bne $t1, $s5, end
add $s3, $s3, 1
j while

end:
addi $t1, $s5, 10
sw $t1, 0($t0)

# ---- LOOP PARA MOSTRAR O VETOR ----
li $s3, 0

print_loop:
sll $t0, $s3, 2
add $t0, $t0, $s6

lw $a0, 0($t0)
li $v0, 1
syscall

# quebra de linha
la $a0, newline
li $v0, 4
syscall

addi $s3, $s3, 1
li $t1, 3
bne $s3, $t1, print_loop

li $v0, 10
syscall

