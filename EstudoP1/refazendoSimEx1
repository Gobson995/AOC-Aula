.data
	msg1: .asciiz "\nDigite 8 numeros: "
	msg2: .asciiz "\nPares: "
	msg3: .asciiz "\nImpares: "
	vetor: .space 32
.text
.globl main

main:
	la $s0, vetor
	li $t0, 0
	li $t1, 8
	li $s1, 0
	li $s2, 0
	la $a0, msg1
	li $v0, 4
	syscall

loop_leitura:
	sll $t2, $t0, 2
	add $t3, $t2, $s0
	li $v0, 5
	syscall
	sw $v0, 0($t3)
	addi $t0, $t0, 1
	bne $t0, $t1, loop_leitura
	
	li $t0, 0
	
loop_paridade:
	sll $t2, $t0, 2
	add $t3, $t2, $s0
	lw $t4, 0($t3)
	andi $t5, $t4, 1
	beq $t5, 1, impar
	
	addi $s1, $s1, 1
	
fim_paridade:
	addi $t0, $t0, 1
	bne $t0, $t1, loop_paridade
	
	la $a0, msg2
	li $v0, 4
	syscall
	move $a0, $s1
	li $v0, 1
	syscall
	la $a0, msg3
	li $v0, 4
	syscall
	move $a0, $s2
	li $v0, 1
	syscall
	
end:
	li $v0, 10
	syscall
	
impar:
	addi $s2, $s2, 1
	j fim_paridade