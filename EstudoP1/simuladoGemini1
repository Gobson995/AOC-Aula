.data
	vetor: .space 20
	linha: .asciiz "\n"

.text
.globl main

main:
	la $s0, vetor
	li $t0, 0
	li $t1, 5
loop_leitura:
	sll $t2, $t0, 2
	add $t3, $t2, $s0
	li $v0, 5
	syscall
	sw $v0, 0($t3)
	addi $t0, $t0, 1
	bne $t0, $t1, loop_leitura
	
	li $t0, 0
	
loop_mud:
	sll $t2, $t0, 2
	add $t3, $t2, $s0
	lw $t4, 0($t3)
	bge $t4, 10, fim_mud
	li $t4, 0
	sw $t4, 0($t3)
fim_mud:
	addi $t0, $t0, 1
	bne $t0, $t1, loop_mud
	
	li $t0, 0
	
loop_imprime:
	sll $t2, $t0, 2
	add $t3, $t2, $s0
	lw $a0, 0($t3)
	li $v0, 1
	syscall
	la $a0, linha
	li $v0, 4
	syscall
	addi $t0, $t0, 1
	bne $t0, $t1, loop_imprime
	
end:
	li $v0, 10
	syscall
	