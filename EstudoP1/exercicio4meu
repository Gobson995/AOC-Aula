.data
	msg: .asciiz "\nProcessando dados...\n"

.text
.globl main

main:
	li $v0, 5
	syscall
	move $a0, $v0
	jal processa_valores
	move $a0, $v0
	li $v0, 1
	syscall
	
end:
	li $v0, 10
	syscall

processa_valores:
	addi $sp, $sp, -12
	sw $ra, 8($sp)
	sw $s0, 4($sp)
	sw $s1, 0($sp)
	
	addi $s0, $a0, 10
	addi $s1, $a0, 20
	
	jal apenas_aviso
	
	li $t0, 0
	add $t0, $s0, $s1
	move $v0, $t0
	
	lw $s1, 0($sp)
	lw $s0, 4($sp)
	lw $ra, 8($sp)
	addi $sp, $sp, 12
	
	jr $ra
	
apenas_aviso:
	la $a0, msg
	li $v0, 4
	syscall
	jr $ra